# You do NOT normally need this file.
#
# The workshop credentials ship sealed in .env.enc. Run `python setup_check.py`,
# enter the password the facilitator reads out, and it writes .env for you.
#
# This example is here for two cases: you are running against your own cluster,
# or you want to point at the local podman fixture instead.

QDRANT_URL=https://<your-cluster>.us-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=<your read-only key>

# Local podman fixture instead of the cluster. No API key needed.
# QDRANT_URL=http://localhost:6333
