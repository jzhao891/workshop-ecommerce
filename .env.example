# Copy to .env and fill in. `.env` is gitignored; never commit your key.

# The workshop cluster. You were emailed both of these.
QDRANT_URL=https://<your-cluster>.us-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=<your read-only key>

# To work against the local podman fixture instead, comment the two lines above
# and uncomment this one. No API key needed.
# QDRANT_URL=http://localhost:6333
